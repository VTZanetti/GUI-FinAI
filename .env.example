# ── Stack integrada (docker compose) ──────────────────────────────────
# Chave de assinatura JWT (dev). EM PRODUÇÃO: gere uma forte e nunca commite.
JWT_SIGNING_KEY=chave-dev-64-caracteres-para-docker-compose-local-000000

# Pluggy (opcional — deixe vazio se não for usar Open Finance)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_ID=

# ── Frontend dev (fora do Docker) ─────────────────────────────────────
# Aponta o Axios direto para a API (sem proxy). Vazio → usa /api (proxy Vite).
VITE_API_BASE_URL=

# Alvo do proxy do Vite (dev). Padrão: http://localhost:8080
VITE_API_TARGET=http://localhost:8080

# Modo demonstração: true → usa mocks locais (GUI funciona SEM backend).
VITE_DEMO_MODE=false
